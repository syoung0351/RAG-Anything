# ── LLM: Claude via Anthropic API ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-4-6

# ── Embeddings: OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Web Search (optional)
BRAVE_SEARCH_API_KEY=BSA-your-brave-key-here

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
PM_BRAIN_API_TOKEN=change-me-to-a-strong-random-token

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=pm_brain
POSTGRES_USER=pm_brain_user
POSTGRES_PASSWORD=change-me-strong-password

# ── LightRAG Storage Backends ──────────────────────────────────────────
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# ── RAGAnything ─────────────────────────────────────────────────────────
WORKING_DIR=/app/rag_storage
ENABLE_LLM_CACHE=true
MAX_ASYNC=4
TEMPERATURE=0
MAX_TOKENS=8192
UPLOAD_DIR=/tmp/uploads

# ── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-droplet-ip-or-domain
NEXT_PUBLIC_API_TOKEN=${PM_BRAIN_API_TOKEN}

# ── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-droplet-ip-or-domain
